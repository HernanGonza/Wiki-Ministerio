# Copiar a .env y completar. NO commitear .env.
# Todos los valores vacíos son obligatorios salvo VAULTWARDEN_URL.

# --- PostgreSQL (superusuario del contenedor; lo usan solo migrate.js y seed.js) ---
POSTGRES_USER=wiki
POSTGRES_PASSWORD=
POSTGRES_DB=wiki

# --- Usuario de la aplicación (permisos mínimos; lo crea migrate.js) ---
# APP_DB_USER: minúsculas, números y guion bajo. Debe ser distinto de POSTGRES_USER.
APP_DB_USER=
APP_DB_PASSWORD=

# --- Sesiones ---
# Clave HMAC para hashear tokens de sesión. Mínimo 32 caracteres aleatorios.
SESSION_SECRET=
# true cuando se sirva por HTTPS
COOKIE_SECURE=false

# --- Administrador global inicial (lo crea seed.js si no existe) ---
ADMIN_EMAIL=
# Mínimo 12 caracteres. Se fuerza el cambio en el primer ingreso.
ADMIN_PASSWORD_INICIAL=

# --- Ingreso único desde el portal del Ministerio (RS256; opcional) ---
# Sin SSO_JWKS_URL el SSO queda desactivado (/sso/* responde 404). Valores de ejemplo (ficticios):
# Emisor (claim iss del pase; incluye el path si el portal cuelga de uno)
SSO_ISSUER=https://ecodatos.example.gob.ar/portal
# JWKS público del portal (https obligatorio; la API debe poder llegar a esa URL)
SSO_JWKS_URL=
# Ej.: https://ecodatos.example.gob.ar/portal/.well-known/jwks.json
# Id de la Wiki en el portal (claim aud)
SSO_AUDIENCE=wiki
# URL del portal: enlace "sin acceso" (sin ?volver) y, de ella, solo el ORIGEN para el anti-CSRF de POST /sso/login
SSO_PORTAL_URL=https://ecodatos.example.gob.ar/portal/
# A dónde redirige el 302 tras el login. Relativo: el nginx de ecodatos quita /wiki/. En desarrollo: /
WIKI_INICIO_URL=/wiki/
# Dirección del portal (botón "Ingresar con el portal" en la pantalla de ingreso)
PORTAL_URL=https://ecodatos.example.gob.ar/portal/

# --- Vaultwarden (solo para armar enlaces; opcional) ---
VAULTWARDEN_URL=

PUBLIC_BASE_URL=http://10.0.0.231:8090
