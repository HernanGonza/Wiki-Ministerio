# Copiar a .env y completar. NO commitear .env.
# Todos los valores vacíos son obligatorios salvo VAULTWARDEN_URL.

# --- PostgreSQL (superusuario del contenedor; lo usan solo migrate.js y seed.js) ---
POSTGRES_USER=wiki
POSTGRES_PASSWORD=
POSTGRES_DB=wiki

# --- Usuario de la aplicación (permisos mínimos; lo crea migrate.js) ---
# APP_DB_USER: minúsculas, números y guion bajo. Debe ser distinto de POSTGRES_USER.
APP_DB_USER=
APP_DB_PASSWORD=

# --- Sesiones ---
# Clave HMAC para hashear tokens de sesión. Mínimo 32 caracteres aleatorios.
SESSION_SECRET=
# true cuando se sirva por HTTPS
COOKIE_SECURE=false

# --- Administrador global inicial (lo crea seed.js si no existe) ---
ADMIN_EMAIL=
# Mínimo 12 caracteres. Se fuerza el cambio en el primer ingreso.
ADMIN_PASSWORD_INICIAL=

# --- Vaultwarden (solo para armar enlaces; opcional) ---
VAULTWARDEN_URL=

PUBLIC_BASE_URL=http://10.0.0.231:8090
